#!/bin/bash
# t3-alpha-deploy — install a zip from t3-alpha-build on every Mac and print one
# `RESULT <host> <status>` line per host:
#   installed    running the new version
#   current      already had this version; left alone
#   busy         an agent turn is running there; left alone (see t3-alpha-install)
#   unreachable  asleep or offline
#   failed       the install failed and rolled back
#   skipped      not attempted because the canary failed
#
# `local` goes first as the canary: if this Mac's install fails, the build is
# broken and no other Mac is touched. A deploy driven from T3 on this Mac finds
# `local` busy (the driving turn itself); install it last with
# `t3-alpha-deploy <zip> local --force`.
#
# Deploying the same zip again only touches the hosts that missed it, so a
# nightly run can re-offer the latest build to Macs that were busy or asleep.
#
# Remote hosts get this checkout's installer copied next to the zip, so no Mac
# carries its own installer copy that can drift.
#
# Usage: t3-alpha-deploy <zip> [host ...] [--force]
#   hosts default to: local emanuel@matebook.lan emanuelfranzen@Mac.lan
#   --force  install even where agent turns are running
# Exits 1 if any host failed.

set -uo pipefail

ZIP="" FORCE="" HOSTS=()
for arg in "$@"; do
  case "$arg" in
    --force) FORCE=--force ;;
    *) if [[ -z "$ZIP" ]]; then ZIP="$arg"; else HOSTS+=("$arg"); fi ;;
  esac
done
[[ -f "$ZIP" ]] || { echo "usage: t3-alpha-deploy <zip> [host ...] [--force]" >&2; exit 2; }
[[ ${#HOSTS[@]} -gt 0 ]] || HOSTS=(local emanuel@matebook.lan emanuelfranzen@Mac.lan)
ZIP="$(cd "$(dirname "$ZIP")" && pwd)/$(basename "$ZIP")"
INSTALLER="$(cd "$(dirname "$0")" && pwd)/t3-alpha-install"
INFO_PLIST="$(unzip -Z1 "$ZIP" | grep -E '^[^/]+\.app/Contents/Info\.plist$')"
VERSION="$(unzip -p "$ZIP" "$INFO_PLIST" | plutil -extract CFBundleShortVersionString raw -)"
[[ -n "$VERSION" ]] || { echo "error: cannot read the app version from $ZIP" >&2; exit 1; }

# Runs a shell command on <host>: directly here, over ssh elsewhere. Stdin is
# closed so nothing on the far side can swallow this script's input.
on() { # <host> <command>
  if [[ "$1" == local ]]; then
    /bin/bash -c "$2" </dev/null
  else
    ssh -o BatchMode=yes -o ConnectTimeout=10 "$1" "$2" </dev/null
  fi
}

deploy() { # <host>; sets STATUS
  local host="$1" zip="$ZIP" installer="$INSTALLER" before out pid rc tries=0 current
  current=$(on "$host" "defaults read '/Applications/T3 Code (Alpha).app/Contents/Info' CFBundleShortVersionString" 2>/dev/null)
  [[ $? == 255 ]] && { STATUS=unreachable; return; }
  [[ "$current" == "$VERSION" ]] && { STATUS=current; return; }
  if [[ "$host" != local ]]; then
    zip="/tmp/$(basename "$ZIP")" installer=/tmp/t3-alpha-install
    scp -q -o BatchMode=yes "$ZIP" "$INSTALLER" "$host:/tmp/" || { STATUS=failed; return; }
  fi
  before=$(on "$host" 'cat ~/Library/Logs/t3-alpha-install.log 2>/dev/null | wc -l' | tr -d ' ')
  out=$(on "$host" "/bin/bash '$installer' '$zip' --expect-version '$VERSION' $FORCE")
  rc=$?
  sed 's/^/   /' <<<"$out"
  if [[ $rc == 3 ]]; then
    STATUS=busy
  elif pid=$(sed -nE 's/.*\(pid ([0-9]+)\).*/\1/p' <<<"$out") && [[ -n "$pid" ]]; then
    # The installer detaches so it survives the app it replaces; wait for it to
    # exit, riding out dropped connections (ssh exits 255) for up to 15 minutes.
    while ((tries++ < 300)); do
      on "$host" "kill -0 $pid 2>/dev/null"
      rc=$?
      [[ $rc == 0 || $rc == 255 ]] || break
      sleep 3
    done
    out=$(on "$host" "tail -n +$((before + 1)) ~/Library/Logs/t3-alpha-install.log")
    sed 's/^/   /' <<<"$out"
    if grep -q "SUCCESS:" <<<"$out"; then STATUS=installed; else STATUS=failed; fi
  else
    STATUS=failed
  fi
  [[ "$host" == local ]] || on "$host" "rm -f '$zip' '$installer'"
}

# The canary first, then the rest in the order given.
ORDERED=()
for host in "${HOSTS[@]}"; do [[ "$host" == local ]] && ORDERED+=(local); done
for host in "${HOSTS[@]}"; do [[ "$host" == local ]] || ORDERED+=("$host"); done

any_failed="" canary_failed=""
for host in "${ORDERED[@]}"; do
  if [[ -n "$canary_failed" ]]; then
    STATUS=skipped
  else
    echo "== $host: $(basename "$ZIP")"
    deploy "$host"
  fi
  [[ "$host" == local && "$STATUS" == failed ]] && canary_failed=1
  [[ "$STATUS" == failed ]] && any_failed=1
  echo "RESULT $host $STATUS"
done
[[ -z "$any_failed" ]]
